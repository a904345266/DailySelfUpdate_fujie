# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment files — ignore every .env variant at ANY depth.
# The leading ** + bare patterns cover root and subdirs (backend/, frontend/).
**/.env
**/.env.*
.env
.env.*
# ...but always allow the example/template files to be committed.
!**/.env.example
!**/.env.local.example
!**/.env.prod.example
!.env.example
!.env.local.example
!.env.prod.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
coverage/
.nyc_output/

# Uploads
uploads/

# Prisma
backend/prisma/migrations/dev.db*

# Postgres data volume
postgres-data/
