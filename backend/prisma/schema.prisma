generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String?
  passwordHash  String   @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  avatarUrl     String?  @map("avatar_url")
  tier          String   @default("free")
  vipExpiresAt  DateTime? @map("vip_expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  
  // 签到相关字段
  totalCheckIns   Int      @default(0) @map("total_check_ins")
  abilityPoints   Int      @default(0) @map("ability_points")
  lastCheckInDate DateTime? @map("last_check_in_date")

  preferences         UserPreferences?
  workRecords         WorkRecord[]
  friendRecords       FriendRecord[]
  partnerRecords      PartnerRecord[]
  gratitudeRecords    GratitudeRecord[]
  dailyReflections    DailyReflection[]
  weeklySummaries     WeeklySummary[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  checkInRecords      CheckInRecord[]

  @@map("users")
}

model CheckInRecord {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  date   DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("check_in_records")
}

model UserPreferences {
  userId              String   @id @map("user_id")
  language            String   @default("zh-CN")
  timezone            String   @default("Asia/Shanghai")
  theme               String   @default("light")
  voiceEnabled        Boolean  @default(true) @map("voice_enabled")
  voiceLanguage       String   @default("zh-CN") @map("voice_language")
  reminderMorning     String   @default("08:00") @map("reminder_morning")
  reminderNoon        String   @default("12:00") @map("reminder_noon")
  reminderEvening     String   @default("21:00") @map("reminder_evening")
  notificationEnabled Boolean  @default(true) @map("notification_enabled")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// Daily records
// ============================================================

model WorkRecord {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime
  content        String
  category       String
  emotion        String
  importance     Int
  timeSpent      String?  @map("time_spent")
  tags           String   @default("[]")
  followUpAction String?  @map("follow_up_action")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("work_records")
}

model FriendRecord {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  date            DateTime
  friendName      String   @map("friend_name")
  interactionType String   @map("interaction_type")
  content         String
  emotion         String
  importance      Int
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("friend_records")
}

model PartnerRecord {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  date            DateTime
  partnerName     String   @map("partner_name")
  interactionType String   @map("interaction_type")
  content         String
  emotion         String
  importance      Int
  resolved        Boolean  @default(false)
  photoUrl        String?  @map("photo_url")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("partner_records")
}

model GratitudeRecord {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  date              DateTime
  content           String
  category          String
  emotion           String
  impactLevel       Int      @map("impact_level")
  photoUrl          String?  @map("photo_url")
  locationLatitude  Float?   @map("location_latitude")
  locationLongitude Float?   @map("location_longitude")
  locationAddress   String?  @map("location_address")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("gratitude_records")
}

model DailyReflection {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  date                DateTime
  morningGoal         String?  @map("morning_goal")
  morningMood         String?  @map("morning_mood")
  noonCheck           String?  @map("noon_check")
  noonProgress        Int?     @map("noon_progress")
  eveningReflection   String?  @map("evening_reflection")
  eveningAchievements String   @default("[]") @map("evening_achievements")
  eveningChallenges   String   @default("[]") @map("evening_challenges")
  overallRating       Int?     @map("overall_rating")
  sleepPrediction     String?  @map("sleep_prediction")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_reflections")
}

model WeeklySummary {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  weekStart            DateTime @map("week_start")
  weekEnd              DateTime @map("week_end")
  workAnalysis         String   @map("work_analysis")
  relationshipAnalysis String   @map("relationship_analysis")
  gratitudeAnalysis    String   @map("gratitude_analysis")
  emotionalAnalysis    String   @map("emotional_analysis")
  growthTracking       String?  @map("growth_tracking")
  aiRecommendations    String   @map("ai_recommendations")
  coverImageUrl        String?  @map("cover_image_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("weekly_summaries")
}