# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Set true when serving through a reverse proxy / Tailscale Funnel (fixes
# express-rate-limit X-Forwarded-For errors). Always on in production.
TRUST_PROXY=false

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dailyselfupdate?schema=public

# JWT
JWT_SECRET=replace-me-with-a-long-random-string-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace-me-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# SMTP (used for password reset emails; safe to leave blank in dev — will log link instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dailyselfupdate.com

# Logging
LOG_LEVEL=debug

# ============================================================
# AI weekly-summary insights (ALL OPTIONAL)
# If nothing here is configured, the app falls back to rule-based insights —
# the feature never breaks, it just won't be LLM-generated.
# ============================================================

# Master switch. false → always use rule-based insights.
AI_ENABLED=false

# Timeout (ms) for a single AI call before falling back to rules.
AI_TIMEOUT_MS=15000

# --- Which provider each tier uses ---
# free tier provider: openai | deepseek   (both speak the OpenAI protocol)
AI_FREE_PROVIDER=deepseek
# vip tier provider: claude | openai | deepseek
AI_VIP_PROVIDER=claude

# --- OpenAI-compatible config (covers OpenAI, DeepSeek, 中转网关, Ollama, etc.) ---
# OpenAI official
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible protocol)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic Claude (used by VIP tier) ---
# Use EITHER the official key, OR an Anthropic-compatible gateway
# (ANTHROPIC_AUTH_TOKEN + ANTHROPIC_BASE_URL — e.g. a new-api proxy fronting GLM).
# When AUTH_TOKEN is set it takes precedence over API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- VIP trial redemption ---
# A user who submits this exact code gets VIP for VIP_TRIAL_DURATION_HOURS.
# Empty → redemption disabled. Change anytime; takes effect on restart.
VIP_TRIAL_CODE=
VIP_TRIAL_DURATION_HOURS=24
