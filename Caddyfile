# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
#
# {$SITE_ADDRESS} comes from the env (set in .env). It may contain MULTIPLE
# space-separated hostnames, e.g.:
#   SITE_ADDRESS="dailyselfupdate.online www.dailyselfupdate.online"
#   SITE_ADDRESS=dailyselfupdate.online:8443   (high port, avoids 备案 on 80/443)
#
# Path routing on ONE site: /api/* → backend, everything else → frontend.
# Frontend is built with NEXT_PUBLIC_API_BASE_URL=/api → same-origin, no CORS,
# one certificate covers all listed hostnames.

{$SITE_ADDRESS} {
	encode gzip

	# Backend API + uploaded assets
	handle /api/* {
		reverse_proxy backend:3001
	}

	# Frontend (Next.js) — everything else
	handle {
		reverse_proxy frontend:3000
	}
}
