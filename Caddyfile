# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
#
# {$SITE_ADDRESS} = space-separated site addresses. List the SAME domain on both
# 443 (implicit) and the high port, so HTTPS works on either. Example:
#   SITE_ADDRESS="dailyselfupdate.online www.dailyselfupdate.online dailyselfupdate.online:8443 www.dailyselfupdate.online:8443"
#
# Why two ports: during ICP 备案 the ISP may block 80/443 → use https://<domain>:8443
# meanwhile. Once 备案 passes, https://<domain> (443) just works. The cert is
# obtained once (via port 80 ACME) and reused on the high port too.
#
# Path routing: /api/* → backend, everything else → frontend (same-origin).

{$SITE_ADDRESS} {
	encode gzip
	handle /api/* {
		reverse_proxy backend:3001
	}
	handle {
		reverse_proxy frontend:3000
	}
}
