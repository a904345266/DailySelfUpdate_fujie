# Copy to .env (without .prod.example) and fill in for `docker compose -f docker-compose.prod.yml up -d`

# --- database ---
POSTGRES_DB=dailyselfupdate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # required — set a strong password

# --- backend ---
FRONTEND_URL=https://your-domain.com
JWT_SECRET=  # required — generate with: openssl rand -base64 48
REFRESH_TOKEN_SECRET=  # required — generate with: openssl rand -base64 48
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
LOG_LEVEL=info

# --- email (optional in dev, recommended in prod) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# --- frontend (build-time, baked into the bundle) ---
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api
