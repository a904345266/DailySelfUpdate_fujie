# Copy to .env (without .prod.example) and fill in for `docker compose -f docker-compose.prod.yml up -d`

# --- HTTPS / Caddy (only needed when running with docker-compose.caddy.yml) ---
# Your domain, optionally with a high port to avoid 80/443 ICP 备案 拦截.
#   SITE_ADDRESS=yourdomain.com        # standard HTTPS (443) — needs 备案 in 大陆
#   SITE_ADDRESS=yourdomain.com:8443   # high-port HTTPS — usually no 备案 needed
SITE_ADDRESS=

# --- database ---
POSTGRES_DB=dailyselfupdate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # required — set a strong password

# --- backend ---
FRONTEND_URL=https://your-domain.com
JWT_SECRET=  # required — generate with: openssl rand -base64 48
REFRESH_TOKEN_SECRET=  # required — generate with: openssl rand -base64 48
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
LOG_LEVEL=info

# Set true when behind a reverse proxy (nginx/Tailscale). Always recommended in prod.
TRUST_PROXY=true

# --- email (optional in dev, recommended in prod) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# --- AI insights (optional; unset → rule-based fallback) ---
AI_ENABLED=false
AI_TIMEOUT_MS=15000
AI_FREE_PROVIDER=deepseek          # openai | deepseek | claude
AI_VIP_PROVIDER=claude             # openai | deepseek | claude
# OpenAI-compatible (covers OpenAI / DeepSeek / 中转网关)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Anthropic OR an Anthropic-compatible gateway (AUTH_TOKEN takes precedence)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- VIP trial redemption ---
VIP_TRIAL_CODE=                    # 兑换口令；留空则关闭兑换
VIP_TRIAL_DURATION_HOURS=24

# --- frontend (build-time, baked into the bundle) ---
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api
